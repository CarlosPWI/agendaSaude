# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Service role key (NUNCA expor no frontend) — necessária para o
# DELETE /usuarios/{id} remover a conta também do Supabase Auth
SUPABASE_SERVICE_ROLE_KEY=

# URL do frontend (usada no link de recuperação de senha)
FRONTEND_URL=http://localhost:5173

# Brevo (ex-Sendinblue) — notificações por e-mail aos pacientes.
# O remetente (BREVO_FROM_EMAIL) precisa estar verificado na conta Brevo.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Agenda Saúde

# CORS (origens permitidas, separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://agenda-saude-omega.vercel.app

# Redis (opcional) — rate limit compartilhado entre instâncias.
# Sem essa variável, o rate limit é em memória (por processo).
# REDIS_URL=redis://localhost:6379/0